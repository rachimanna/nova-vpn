# ================= NOVA VPN =================
# Copy to .env and fill in. Never commit .env.
# Fresh secrets: cd backend && python -m app.cli gen-secrets

# --- Telegram ---
BOT_TOKEN=                       # from @BotFather
WEBAPP_URL=https://vpn.example.com   # public HTTPS URL of the Mini App (Telegram requires https)
ADMIN_TELEGRAM_IDS=              # your Telegram ID(s), comma separated -> /admin in the bot
SUPPORT_URL=                     # optional, support button inside Happ, e.g. https://t.me/your_bot

# --- Secrets ---
SECRET_KEY=                      # signs admin sessions and download links
ENCRYPTION_KEY=                  # Fernet key, encrypts client private keys. Losing it = all configs must be reissued
ADMIN_PASSWORD=                  # password for /admin in the browser (empty = password login disabled)

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./nova.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://nova:password@127.0.0.1:5432/nova

# --- Defaults for new users ---
DEFAULT_DEVICE_LIMIT=3
DEFAULT_TRAFFIC_LIMIT_GB=50      # 0 = unlimited
DEFAULT_ACCESS_DAYS=30

# --- Behaviour ---
POLL_INTERVAL=60                 # seconds between node stats polls
RATE_LIMIT_PER_MINUTE=90
CORS_ORIGINS=                    # only if the frontend is hosted on another origin
DEV_MODE=false                   # true = browser testing without Telegram + mock data. NEVER in production

# --- Deployment (docker compose) ---
DOMAIN=vpn.example.com           # only for `docker compose --profile caddy` (WireGuard-only setup)
